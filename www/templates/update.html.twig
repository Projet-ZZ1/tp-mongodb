{% extends "base.html.twig" %}

{% block title %}Modification d'un livre{% endblock %}

{% block content %}
    <p>&larr;&nbsp;<a href="/index.php">Retourner à la liste</a></p>

    <form action="/update.php" method="post">
        <input type="hidden" id="id" name="id" value="{{ entity._id }}">

        <label for="title">Titre :</label>
        <input type="text" id="title" name="titre" value="{{ entity.titre|default('') }}" size="100">

        <label for="author">Auteur :</label>
        <input type="text" id="author" name="auteur" size="50" value="{{ entity.auteur|default('') }}">

        <label for="edition">Édition :</label>
        <input type="text" id="edition" name="edition" value="{{ entity.edition|default('') }}">

        <label for="langue">Langue :</label>
        <input type="text" id="langue" name="langue" value="{{ entity.langue|default('') }}">

        <label for="cote">Cote :</label>
        <input type="text" id="cote" name="cote" value="{{ entity.cote|default('') }}">

        <label for="century">Siècle :</label>
        <input type="number" id="century" name="siecle" value="{{ entity.siecle|default('') }}">

        <button type="submit">Enregistrer</button>
    </form>
{% endblock %}
